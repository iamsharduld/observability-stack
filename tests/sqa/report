#!/usr/bin/env python3
"""Write the files SolQA's pipeline uploads after running `sqa_tests`.

- test_results.xml: a JUnit report with one test case per check. SolQA's test
  step ignores our exit code (`continue-on-error`), so this file is how a
  failed check stays visible.
- metrics.json: what the model actually runs (charm, channel, revision and
  resource revisions per application), so the stable gate can check that
  SolQA tested exactly the revisions it pinned (`just solution verify-pin`),
  plus the test environment the pipeline describes in CLUSTER, SUBSTRATE and
  JUJU_CHANNEL (see SolQA's spec, SQ088).

Usage: report <results file> <model>
Each line of the results file is "<check>\t<exit code>\t<seconds>\t<log file>".
Only the standard library is used, since this runs on SolQA's runner.
"""

import json
import os
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

# How much of a failed check's output goes into its JUnit failure message
LOG_TAIL_LINES = 100


def write_junit(results_file: Path, out: Path) -> None:
    suites = ET.Element("testsuites")
    suite = ET.SubElement(suites, "testsuite", name="sqa_tests")
    failures = 0
    total_seconds = 0
    lines = [line for line in results_file.read_text().splitlines() if line.strip()]
    for line in lines:
        check, code, seconds, log = line.split("\t")
        total_seconds += int(seconds)
        case = ET.SubElement(
            suite, "testcase", classname="sqa_tests", name=check, time=seconds
        )
        if code != "0":
            failures += 1
            tail = Path(log).read_text(errors="replace").splitlines()[-LOG_TAIL_LINES:]
            failure = ET.SubElement(
                case, "failure", message=f"{check} exited with code {code}"
            )
            failure.text = "\n".join(tail)
    suite.set("tests", str(len(lines)))
    suite.set("failures", str(failures))
    suite.set("time", str(total_seconds))
    ET.ElementTree(suites).write(out, encoding="utf-8", xml_declaration=True)


def juju_json(*args: str) -> dict:
    result = subprocess.run(
        ["juju", *args, "--format=json"], check=True, capture_output=True, text=True
    )
    return json.loads(result.stdout)


def deployed(model: str) -> dict:
    status = juju_json("status", "--model", model)
    applications = {}
    for name, app in status.get("applications", {}).items():
        resources = juju_json("resources", name, "--model", model).get("resources", [])
        applications[name] = {
            "charm": app.get("charm-name"),
            "channel": app.get("charm-channel"),
            "revision": app.get("charm-rev"),
            "origin": app.get("charm-origin"),
            # Store resources have numeric revisions; uploaded ones don't
            "resources": {
                r["name"]: int(r["revision"])
                for r in resources
                if str(r.get("revision", "")).isdigit()
            },
        }
    return {"model": model, "applications": applications}


def main() -> int:
    results_file, model = Path(sys.argv[1]), sys.argv[2]
    write_junit(results_file, Path("test_results.xml"))
    try:
        metrics = deployed(model)
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError) as e:
        print(
            f"ERROR: could not read what is deployed in '{model}': {e}", file=sys.stderr
        )
        metrics = {"model": model, "applications": {}, "error": str(e)}
    metrics["environment"] = {
        var.lower(): os.environ.get(var)
        for var in ("CLUSTER", "SUBSTRATE", "JUJU_CHANNEL")
    }
    Path("metrics.json").write_text(
        json.dumps(metrics, indent=2, sort_keys=True) + "\n"
    )
    return 1 if "error" in metrics else 0


if __name__ == "__main__":
    sys.exit(main())
