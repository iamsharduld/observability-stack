#!/usr/bin/env bash
# TEMPORARY diagnostic for TAP-1522 (not for merging): what can SolQA's runner
# reach in the deployed COS Lite model? Probes use short timeouts.
set -u
MODEL=cos
hr() { echo; echo "================ $*"; }

hr runner
hostname; hostname -I; ip route 2>/dev/null | head -20
for t in juju kubectl curl python3 jq uv; do printf '%s: ' "$t"; command -v "$t" || echo missing; done
ls -la ~/.kube 2>/dev/null || echo "no ~/.kube"

hr juju
juju whoami
juju status -m "$MODEL"

probe() {  # name url
    out=$(curl -k -sS -o /dev/null -w '%{http_code} in %{time_total}s' --connect-timeout 5 -m 10 "$2" 2>&1)
    echo "PROBE $1 $2 -> $out"
}

hr "direct probes (unit and service addresses)"
juju status -m "$MODEL" --format json | python3 -c '
import json, sys
s = json.load(sys.stdin)
for app, a in s["applications"].items():
    for unit, u in a.get("units", {}).items():
        print(app, u.get("address", ""), a.get("address", ""))
' | while read -r app unit_ip app_ip; do
    case "$app" in grafana) p=3000 ;; prometheus) p=9090 ;; loki) p=3100 ;; alertmanager) p=9093 ;; catalogue) p=80 ;; traefik) p=80 ;; *) continue ;; esac
    for scheme in http https; do
        probe "$app/unit" "$scheme://$unit_ip:$p"
        probe "$app/service" "$scheme://$app_ip:$p"
    done
done

hr "traefik proxied endpoints"
eps=$(juju run -m "$MODEL" traefik/0 show-proxied-endpoints --format json 2>&1)
echo "$eps"
echo "$eps" | grep -oE 'https?://[^"\\ ]+' | sort -u | while read -r url; do
    probe "ingress" "$url"
    for path in /api/health /-/ready /ready; do probe "ingress" "${url%/}$path"; done
done

hr "checks from inside a unit (juju exec)"
for target in grafana/0:3000:/api/health prometheus/0:9090:/-/ready loki/0:3100:/ready; do
    unit=${target%%:*}; rest=${target#*:}; port=${rest%%:*}; path=${rest#*:}
    for scheme in http https; do
        echo "EXEC $unit $scheme://localhost:$port$path ->" \
            "$(timeout 60 juju exec -m "$MODEL" --unit "$unit" -- python3 -c "import ssl,urllib.request as r;print(r.urlopen('$scheme://localhost:$port$path',timeout=5,context=ssl._create_unverified_context()).status)" 2>&1 | tail -1)"
    done
done
exit 0
