#!/usr/bin/env bash
# SolQA entry point: test the deployed "cos" model and record its revisions.
# Outputs: test_results.xml (JUnit) and metrics.json (tested revisions).
# Usage: ./sqa_tests [cos|cos-lite] [pytest args]; defaults to $PRODUCT.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
rm -f test_results.xml metrics.json

MODEL="cos"
UV_FLAGS=(--frozen --isolated --python 3.12)

solution="${1:-${PRODUCT:-}}"
if [ $# -gt 0 ]; then shift; fi
case "$solution" in
    cos | cos-lite) ;;
    *)
        echo "ERROR: unknown solution '$solution'; pass cos or cos-lite, or set PRODUCT" >&2
        exit 1
        ;;
esac

if ! command -v uv &> /dev/null; then
    echo "Installing astral-uv (snap, provides 'uv')..."
    sudo snap install astral-uv --classic
fi

# SolQA cannot reach the pod network; relay HTTP requests through Grafana.
# Always write metrics, preserving the test exit code if tests fail.
tests_exit=0
(
    cd tests/solution
    SOLUTION_MODEL="$MODEL" SOLUTION_HTTP_RELAY=grafana uv run "${UV_FLAGS[@]}" pytest -vv -ra "$solution" \
        --junitxml="$SCRIPT_DIR/test_results.xml" "$@"
) || tests_exit=$?

metrics_exit=0
uv run "${UV_FLAGS[@]}" python tests/sqa/write_metrics.py "$MODEL" metrics.json || metrics_exit=$?

if [ "$tests_exit" -ne 0 ]; then exit "$tests_exit"; fi
exit "$metrics_exit"
