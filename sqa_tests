#!/usr/bin/env bash
# DIAGNOSTIC (do not merge): after terragrunt-deployment-pipelines#274, the
# runner gets HTTP 503 from Traefik's load balancer address. Is that Traefik or
# the egress proxy? Calls the address from the Juju controller machine and a
# Kubernetes machine (no proxy), then from the runner, printing the response
# headers (squid adds X-Squid-Error). Exit code: 0 if the runner gets 200, else 1.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
rm -f test_results.xml

MODEL="cos"
# SolQA's runners have Python 3.10; the tests need 3.12.
UV_FLAGS=(--frozen --isolated --python 3.12)

if ! command -v uv &> /dev/null; then
    echo "Installing astral-uv (snap, provides 'uv')..."
    sudo snap install astral-uv --classic
fi

hr() { printf '\n================ [%s] %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

hr "0. wait until COS is active and idle"
if ! (cd tests/solution && MODEL="$MODEL" uv run "${UV_FLAGS[@]}" python -c \
    'import os, jubilant; from helpers import wait_for_active_idle; wait_for_active_idle(jubilant.Juju(model=os.environ["MODEL"]))'); then
    echo "not settled, carrying on"
fi

hr "1. load balancer settings"
K8S_MODEL=""
for m in $(juju models --format json | jq -r '.models[]."short-name"'); do
    if juju status -m "$m" --format json | jq -e '[.applications[]?.charm] | index("k8s")' > /dev/null; then
        K8S_MODEL=$m
        break
    fi
done
echo "k8s model: ${K8S_MODEL:-none}"
if [ -n "$K8S_MODEL" ]; then
    timeout 300 juju exec -m "$K8S_MODEL" --unit k8s/leader -- \
        "/snap/bin/k8s get load-balancer; /snap/bin/k8s kubectl get svc -n $MODEL traefik-lb -o wide" 2>&1 || true
fi
LB=$(juju status -m "$MODEL" traefik --format json | jq -r '.applications.traefik.units[]."workload-status".message' | grep -oE '[0-9]+(\.[0-9]+){3}' | head -1 || true)
echo "traefik's load balancer address: ${LB:-none}"
if [ -z "$LB" ]; then
    echo "ERROR: no load balancer address in Traefik's status" >&2
    exit 1
fi
URL="http://$LB/cos-grafana/api/health"

hr "2. from inside the lab, no proxy: the Juju controller machine, then a Kubernetes machine"
timeout 120 juju exec -m controller --machine 0 -- \
    "curl --noproxy '*' -sS -D - -o /dev/null -m 10 -w 'code=%{http_code} total=%{time_total}s' $URL" 2>&1 || true
echo
if [ -n "$K8S_MODEL" ]; then
    timeout 120 juju exec -m "$K8S_MODEL" --machine 0 -- \
        "curl --noproxy '*' -sS -D - -o /dev/null -m 10 -w 'code=%{http_code} total=%{time_total}s' $URL" 2>&1 || true
    echo
fi

hr "3. from the runner, through the egress proxy (up to 2 minutes)"
code=000
for _ in $(seq 1 12); do
    code=$(curl -sS -o /dev/null -m 10 -w '%{http_code}' "$URL" 2> /dev/null || true)
    echo "$(date -u +%H:%M:%SZ) GET $URL -> ${code:-000}"
    if [ "$code" = 200 ]; then break; fi
    sleep 10
done

hr "4. from the runner: response headers, and how it routes to the address"
curl -sS -D - -o /dev/null -m 10 "$URL" 2>&1 || true
echo "--- asking the egress proxy directly (squid adds X-Squid-Error when it fails)"
curl -sS -D - -o /dev/null -m 70 -x http://egress.ps7.internal:3128 "$URL" 2>&1 || true
ip route get "$LB" || true
env | grep -i '_proxy=' | sed -E 's#://[^@/]*@#://***@#' || true

hr "result"
if [ "$code" = 200 ]; then
    echo "PASSED: the runner reached Traefik's load balancer address"
else
    echo "FAILED: the runner didn't get 200 from Traefik's load balancer address"
    exit 1
fi
