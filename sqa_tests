#!/usr/bin/env bash
# sqa_tests: entry point for SolQA's "Run SQA tests" step.
#
# SolQA's Deploy Product pipeline (canonical/terragrunt-deployment-pipelines)
# deploys COS or COS Lite into the "cos" model, checks out this repo at the ref
# given in its test_parameters input, and runs ./sqa_tests from here. The name
# and the outputs are the contract (SolQA's spec SQ088):
#   - test_results.xml: a JUnit report, next to this script
#   - metrics.json: free-form; we record what the model actually runs
#
# What it does: runs the solution tests (tests/solution) against the deployed
# model instead of deploying one with Terraform, has pytest write
# test_results.xml, then records the deployed charm and resource revisions in
# metrics.json, which the stable quality gate compares with what it pinned.
#
# Usage:
#   ./sqa_tests cos-lite              # the solution to test (default: $PRODUCT,
#                                     # which the pipeline sets)
#   ./sqa_tests cos-lite -k metrics   # further arguments go to pytest
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

MODEL="cos"
UV_FLAGS=(--frozen --isolated)

solution="${1:-${PRODUCT:-}}"
if [ $# -gt 0 ]; then shift; fi
case "$solution" in
    cos | cos-lite) ;;
    *)
        echo "ERROR: unknown solution '$solution'; pass cos or cos-lite, or set PRODUCT" >&2
        exit 1
        ;;
esac

if ! command -v uv &> /dev/null; then
    echo "Installing astral-uv (snap, provides 'uv')..."
    sudo snap install astral-uv --classic
fi

# Run every scenario, then write metrics.json whatever the outcome
tests_exit=0
(
    cd tests/solution
    SOLUTION_MODEL="$MODEL" uv run "${UV_FLAGS[@]}" pytest -vv -ra "$solution" \
        --junitxml="$SCRIPT_DIR/test_results.xml" "$@"
) || tests_exit=$?

metrics_exit=0
uv run "${UV_FLAGS[@]}" python tests/sqa/write_metrics.py "$MODEL" metrics.json || metrics_exit=$?

if [ "$tests_exit" -ne 0 ]; then exit "$tests_exit"; fi
exit "$metrics_exit"
